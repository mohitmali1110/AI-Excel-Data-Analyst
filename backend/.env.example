# .env.example
# Copy this file to .env and fill in your API key.
# The application works WITHOUT an LLM key using fallback mode.

# ── LLM Provider Configuration ─────────────────────────────────────
# Supported: OpenAI, Groq, Together AI, or any OpenAI-compatible API

# Your LLM API Key (leave empty to use fallback/keyword mode)
LLM_API_KEY=

# Model name to use
# OpenAI examples:   gpt-4o-mini, gpt-3.5-turbo
# Groq examples:     llama3-8b-8192, mixtral-8x7b-32768
# Together examples: meta-llama/Llama-3-8b-chat-hf
LLM_MODEL=gpt-4o-mini

# API Base URL
# OpenAI:   https://api.openai.com/v1
# Groq:     https://api.groq.com/openai/v1
# Together: https://api.together.xyz/v1
LLM_BASE_URL=https://api.openai.com/v1
